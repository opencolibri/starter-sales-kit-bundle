{
    "name": "opencolibri/starter-sales-kit-bundle",
    "description": "Colibri Starter sales kit: Symfony bundle of the demo shop admin (shops, datasets, castor-api runs), built on Sylius Shadcn Admin UI",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "sales-kit",
        "shadcn",
        "admin"
    ],
    "homepage": "https://github.com/opencolibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lc.fremont@gmail.com"
        },
        {
            "name": "Jérôme Gangneux",
            "email": "jerome@gangneux.net"
        }
    ],
    "require": {
        "php": ">=8.3",
        "knplabs/knp-menu-bundle": "^3.0",
        "opencolibri/starter-core": "self.version",
        "opencolibri/starter-datasets": "self.version",
        "opencolibri/starter-themes": "self.version",
        "pagerfanta/core": "^4.6",
        "sylius/admin-ui": "^0.14",
        "sylius/grid-bundle": "^1.13",
        "sylius/shadcn-admin-ui": "^0.14@dev",
        "sylius/twig-hooks": "^0.14",
        "sylius/ui-translations": "^0.14",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/security-bundle": "^7.4",
        "symfony/ux-live-component": "^2.30 || ^3.5",
        "symfony/validator": "^7.4",
        "symfony/yaml": "^7.4|^8.0"
    },
    "require-dev": {
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/css-selector": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\SalesKitBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\SalesKitBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
