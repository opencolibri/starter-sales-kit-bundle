{% set run = this.run %}
{% set running = this.running %}
{% set badges = {
    pending: ['secondary', 'opencolibri_sales_kit.run.pending'],
    running: ['default', 'opencolibri_sales_kit.run.running'],
    completed: ['success', 'opencolibri_sales_kit.run.completed'],
    failed: ['destructive', 'opencolibri_sales_kit.run.failed'],
    unknown: ['destructive', 'opencolibri_sales_kit.run.unknown'],
} %}
{% from '@SyliusShadcnAdminUi/shared/helper/ui.html.twig' import button_class %}
<div {{ attributes.defaults(running or this.hasActiveRuns ? {'data-poll': 'delay(2000)|refresh'} : {}) }}>
    {% if runs %}
        <section aria-live="polite" aria-label="{{ 'opencolibri_sales_kit.run.tasks'|trans }}" class="fixed end-4 bottom-4 z-40 flex max-h-[50vh] w-[min(26rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-xl bg-popover text-popover-foreground shadow-lg ring-1 ring-foreground/10">
            <div class="flex items-center gap-2 border-b px-4 py-2.5 text-sm font-medium">
                {{ ux_icon('lucide:list-checks', {class: 'size-4 text-muted-foreground', 'aria-hidden': 'true'}) }}
                {{ 'opencolibri_sales_kit.run.tasks'|trans }}
            </div>
            <ul class="flex flex-col overflow-y-auto">
                {% for id, item in runs %}
                    {% set badge = badges[item.status]|default(['secondary', item.status]) %}
                    {% set progress = this.progress(id) %}
                    <li class="flex flex-wrap items-center gap-2 border-b px-4 py-2.5 text-sm last:border-b-0{{ id == runId ? ' bg-muted' }}">
                        {% if item.status in ['pending', 'running'] %}
                            {{ ux_icon('lucide:loader-2', {class: 'size-4 shrink-0 animate-spin text-primary', 'aria-hidden': 'true'}) }}
                        {% endif %}
                        <button type="button" class="min-w-0 flex-1 basis-0 truncate text-start hover:underline" data-action="live#action" data-live-action-param="open" data-live-run-id-param="{{ id }}" title="{{ 'opencolibri_sales_kit.run.show_logs'|trans }}">
                            {{ this.label(item.task) }}{% if item.subject %} <span class="text-muted-foreground">· {{ item.subject }}</span>{% endif %}
                        </button>
                        {{ _self.badge(badge) }}
                        {% if item.status not in ['pending', 'running'] %}
                            <button type="button" class="{{ button_class('ghost', 'icon-xs', 'text-muted-foreground') }}" aria-label="{{ 'opencolibri_sales_kit.run.forget'|trans }}" data-action="live#action" data-live-action-param="forget" data-live-run-id-param="{{ id }}">
                                {{ ux_icon('lucide:x', {'aria-hidden': 'true'}) }}
                            </button>
                        {% endif %}
                        {% if progress %}
                            <div class="w-full text-xs text-muted-foreground">{{ _self.progress_bar(progress, 'h-1.5') }}</div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if run %}
        {% set status = run.status %}
        {% set badge = badges[status]|default([status in ['failed', 'unknown'] ? 'destructive' : 'default', status]) %}
        <div class="fixed inset-0 z-50 bg-black/50 supports-backdrop-filter:backdrop-blur-xs" aria-hidden="true" data-action="click->live#action" data-live-action-param="dismiss"></div>
        <div role="dialog" aria-modal="true" aria-labelledby="run-modal-title"
             data-action="keydown.esc@window->live#action" data-live-action-param="dismiss"
             class="fixed top-1/2 left-1/2 z-50 flex max-h-[calc(100vh-2rem)] w-[calc(100vw-2rem)] max-w-4xl -translate-x-1/2 -translate-y-1/2 flex-col gap-4 rounded-xl bg-background p-6 text-sm shadow-lg ring-1 ring-foreground/10 {{ status in ['failed', 'unknown'] ? 'ring-destructive/40' }}">
            <div class="flex items-start justify-between gap-4">
                <div class="flex flex-col gap-1.5">
                    <div class="flex flex-wrap items-center gap-2">
                        {% if running %}{{ ux_icon('lucide:loader-2', {class: 'size-4 animate-spin text-primary', 'aria-hidden': 'true'}) }}{% endif %}
                        <h2 id="run-modal-title" class="text-base font-medium">{{ this.taskLabel }}</h2>
                        {{ _self.badge(badge) }}
                    </div>
                    <p class="text-xs text-muted-foreground">
                        <code class="font-mono">{{ task }}</code> · {{ runId }}
                        {%- if run.durationMs is defined and run.durationMs is not null %} · {{ (run.durationMs / 1000)|number_format(1) }} s{% endif %}
                        {%- if run.exitCode is defined and run.exitCode is not null %} · {{ 'opencolibri_sales_kit.run.exit_code'|trans }} {{ run.exitCode }}{% endif %}
                    </p>
                </div>
                <button type="button" class="{{ button_class('ghost', 'icon-sm') }}" aria-label="{{ 'sylius_shadcn_admin_ui.ui.close'|trans }}" data-action="live#action" data-live-action-param="dismiss">
                    {{ ux_icon('lucide:x', {'aria-hidden': 'true'}) }}
                </button>
            </div>

            <div class="flex min-h-0 flex-col gap-3 overflow-y-auto">
                {% if running %}
                    {% set progress = this.progress(runId) %}
                    {% if progress %}{{ _self.progress_bar(progress, 'h-2.5') }}{% endif %}
                    <p class="text-muted-foreground">{{ 'opencolibri_sales_kit.run.logs_later'|trans }}</p>
                {% elseif status == 'unknown' %}
                    <p class="text-destructive">{{ 'opencolibri_sales_kit.run.status_error'|trans }} {{ run.error }}</p>
                {% else %}
                    {% if run.stderr %}
                        <details open class="group">
                            <summary class="cursor-pointer font-medium">{{ 'opencolibri_sales_kit.run.errors'|trans }}</summary>
                            <pre class="mt-2 overflow-auto rounded-lg bg-muted p-3 font-mono text-xs whitespace-pre-wrap text-destructive">{{ run.stderr }}</pre>
                        </details>
                    {% endif %}
                    {% if run.stdout %}
                        <details{{ status == 'failed' and not run.stderr ? ' open' }}>
                            <summary class="cursor-pointer font-medium">{{ 'opencolibri_sales_kit.run.log'|trans }} <span class="font-normal text-muted-foreground">({{ 'opencolibri_sales_kit.run.lines'|trans({'%count%': run.stdout|split("\n")|length}) }})</span></summary>
                            <pre class="mt-2 overflow-auto rounded-lg bg-muted p-3 font-mono text-xs whitespace-pre-wrap">{{ run.stdout }}</pre>
                        </details>
                    {% endif %}
                    {% if not run.stdout and not run.stderr %}
                        <p class="text-muted-foreground">{{ 'opencolibri_sales_kit.run.no_output'|trans }}</p>
                    {% endif %}
                {% endif %}
            </div>

            <div class="flex justify-end">
                <button type="button" class="{{ button_class(running ? 'outline' : 'default') }}" data-action="live#action" data-live-action-param="dismiss">
                    {{ (running ? 'opencolibri_sales_kit.run.hide' : 'sylius_shadcn_admin_ui.ui.close')|trans }}
                </button>
            </div>
        </div>
    {% endif %}
</div>

{% macro badge(badge) %}
    {% set classes = {
        default: 'bg-primary text-primary-foreground',
        secondary: 'bg-secondary text-secondary-foreground',
        success: 'bg-success/10 text-success',
        destructive: 'bg-destructive/10 text-destructive',
    } %}
    <span data-slot="badge" class="inline-flex h-5 shrink-0 items-center rounded-4xl px-2 text-xs font-medium whitespace-nowrap {{ classes[badge[0]]|default(classes.secondary) }}">{{ badge[1]|trans }}</span>
{% endmacro %}

{% macro progress_bar(progress, height) %}
    <div class="mb-1 flex justify-between gap-2">
        <span class="truncate">{{ progress.label }}{% if progress.current %} · {{ progress.current }}{% endif %}</span>
        <span class="whitespace-nowrap tabular-nums">{{ progress.done }}/{{ progress.total }}</span>
    </div>
    <div class="{{ height }} w-full overflow-hidden rounded-full bg-muted" role="progressbar" aria-label="{{ progress.label }}" aria-valuenow="{{ progress.done }}" aria-valuemin="0" aria-valuemax="{{ progress.total }}">
        <div class="h-full rounded-full bg-primary transition-[width]" style="width: {{ progress.percent }}%"></div>
    </div>
{% endmacro %}
