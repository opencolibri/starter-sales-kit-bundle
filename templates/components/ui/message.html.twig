{#- Inline result of an action: type "error" or "success". Renders nothing without a message. -#}
{%- props message = null, type = 'error' -%}
{%- if message -%}
    {%- if type == 'error' -%}
        <div role="alert" {{ attributes.defaults({class: 'flex items-start gap-2 rounded-lg border border-destructive/30 bg-destructive/5 px-3 py-2 text-sm text-destructive'}) }}>
            {{ ux_icon('lucide:circle-alert', {class: 'mt-0.5 size-4 shrink-0', 'aria-hidden': 'true'}) }}
            <span>{{ message }}</span>
        </div>
    {%- else -%}
        <div role="status" {{ attributes.defaults({class: 'flex items-start gap-2 rounded-lg border border-success/30 bg-success/5 px-3 py-2 text-sm'}) }}>
            {{ ux_icon('lucide:circle-check', {class: 'mt-0.5 size-4 shrink-0 text-success', 'aria-hidden': 'true'}) }}
            <span>{{ message }}</span>
        </div>
    {%- endif -%}
{%- endif -%}
